{
  "name": "pi-subconscious",
  "version": "0.1.0",
  "description": "Independent private thinking and foreground-aware scheduling for the Pi agent",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "agent",
    "subconscious"
  ],
  "files": [
    "src",
    "skills",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "pi-subconscious": "src/cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./service": "./src/service.js",
    "./rpc": "./src/rpc.js",
    "./native": "./src/native.js",
    "./rpc-extension": "./src/rpc-extension.js"
  },
  "pi": {
    "extensions": [
      "./src/extension.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test --test-timeout=120000 test/*.test.js",
    "check": "npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "typebox": "1.3.27"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
